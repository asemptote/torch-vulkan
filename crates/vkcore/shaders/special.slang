// axis T: f32=float f64=double
// axis G: bes=0 mod=1 gam=2 erf=3 poly=4
//
// Special functions: out = f(a) or f(a, b), strided with broadcasting. OP
// is a SPECIAL_* code; the functions are PyTorch's CPU ones (_special.slang,
// generated by tools/port_special.py), so results agree with the CPU to a
// few ulp. POLYGAMMA takes its order n as the parameter alpha; the
// polynomials take their degree n from b (truncated to an integer, as on
// the CPU). The functions are split into groups (axis G), one module each:
// a single module with all of them is too large for some drivers' compilers
// in float64 (where every transcendental is software).

#define OUT_T T
#define IN_T T
#define B_T T
#include "_strided.slang"
#include "_fmath.slang"
#include "_special.slang"

[vk::constant_id(0)]
const int OP = SPECIAL_I0;

FT polygamma(int n, FT x)
{
    if (n == 0) return m_digamma(x);
    if (n == 1) return trigamma(x);
    FT sign = (n % 2) != 0 ? FT(1) : FT(-1);
    return sign * m_exp(m_lgamma(FT(n) + FT(1))) * zeta(FT(n + 1), x);
}

FT i0(FT x)
{
    FT a = abs(x);
    if (a <= FT(8)) return m_exp(a) * cheb_i0e_A(a / FT(2) - FT(2));
    return m_exp(a) * cheb_i0e_B(FT(32) / a - FT(2)) / sqrt(a);
}

FT i0e(FT x)
{
    FT a = abs(x);
    if (a <= FT(8)) return cheb_i0e_A(a / FT(2) - FT(2));
    return cheb_i0e_B(FT(32) / a - FT(2)) / sqrt(a);
}

FT i1(FT x)
{
    FT a = abs(x), r;
    if (a <= FT(8)) r = m_exp(a) * a * cheb_i1e_A(a / FT(2) - FT(2));
    else r = m_exp(a) * cheb_i1e_B(FT(32) / a - FT(2)) / sqrt(a);
    return x < FT(0) ? -r : r;
}

FT i1e(FT x)
{
    FT a = abs(x), r;
    if (a <= FT(8)) r = cheb_i1e_A(a / FT(2) - FT(2)) * a;
    else r = cheb_i1e_B(FT(32) / a - FT(2)) / sqrt(a);
    return x < FT(0) ? -r : r;
}

// The polynomials' degree: NaN degrees are NaN results (handled by the
// caller), others truncate toward zero as the CPU's int64 cast does.
int64_t degree(FT n) { return int64_t(n); }

FT apply(FT x, FT y)
{
    switch (OP)
    {
#if defined(G_bes)
    case SPECIAL_I0: return i0(x);
    case SPECIAL_I0E: return i0e(x);
    case SPECIAL_I1: return i1(x);
    case SPECIAL_I1E: return i1e(x);
    case SPECIAL_BESSEL_J0: return bessel_j0_forward(x);
    case SPECIAL_BESSEL_J1: return bessel_j1_forward(x);
    case SPECIAL_BESSEL_Y0: return bessel_y0_forward(x);
    case SPECIAL_BESSEL_Y1: return bessel_y1_forward(x);
#elif defined(G_mod)
    case SPECIAL_MODIFIED_I0: return modified_bessel_i0_forward(x);
    case SPECIAL_MODIFIED_I1: return modified_bessel_i1_forward(x);
    case SPECIAL_MODIFIED_K0: return modified_bessel_k0_forward(x);
    case SPECIAL_MODIFIED_K1: return modified_bessel_k1_forward(x);
    case SPECIAL_SCALED_K0: return scaled_modified_bessel_k0_forward(x);
    case SPECIAL_SCALED_K1: return scaled_modified_bessel_k1_forward(x);
    case SPECIAL_SPHERICAL_J0: return spherical_bessel_j0_forward(x);
    case SPECIAL_AIRY_AI: return airy_ai_forward(x);
#elif defined(G_gam)
    case SPECIAL_NDTRI: return calc_ndtri(x);
    case SPECIAL_POLYGAMMA: return polygamma(int(alpha()), x);
    case SPECIAL_ZETA: return zeta(x, y);
    case SPECIAL_IGAMMA: return calc_igamma(x, y);
    case SPECIAL_IGAMMAC: return calc_igammac(x, y);
#elif defined(G_erf)
    case SPECIAL_ERFCX: return calc_erfcx(x);
    case SPECIAL_LOG_NDTR: return calc_log_ndtr(x);
#endif
    }
#if defined(G_poly)
    // Polynomials in x of degree y.
    if (isnan(y)) return y;
    int64_t n = degree(y);
    switch (OP)
    {
    case SPECIAL_CHEBYSHEV_T: return chebyshev_polynomial_t_forward(x, n);
    case SPECIAL_CHEBYSHEV_U: return chebyshev_polynomial_u_forward(x, n);
    case SPECIAL_CHEBYSHEV_V: return chebyshev_polynomial_v_forward(x, n);
    case SPECIAL_CHEBYSHEV_W: return chebyshev_polynomial_w_forward(x, n);
    case SPECIAL_SHIFTED_T: return shifted_chebyshev_polynomial_t_forward(x, n);
    case SPECIAL_SHIFTED_U: return shifted_chebyshev_polynomial_u_forward(x, n);
    case SPECIAL_SHIFTED_V: return shifted_chebyshev_polynomial_v_forward(x, n);
    case SPECIAL_SHIFTED_W: return shifted_chebyshev_polynomial_w_forward(x, n);
    case SPECIAL_HERMITE_H: return hermite_polynomial_h_forward(x, n);
    case SPECIAL_HERMITE_HE: return hermite_polynomial_he_forward(x, n);
    case SPECIAL_LAGUERRE_L: return laguerre_polynomial_l_forward(x, n);
    default: return legendre_polynomial_p_forward(x, n);  // SPECIAL_LEGENDRE_P
    }
#else
    return m_nan();
#endif
}

[shader("compute")]
[numthreads(64, 1, 1)]
void main(uint3 id: SV_DispatchThreadID)
{
    for (uint i = id.x; i < p.n; i += p.stride)
    {
        Offsets o = offsets(i);
        T y = OP >= SPECIAL_ZETA ? p.b[o.b] : T(0);
        p.out[o.o] = apply(p.a[o.a], y);
    }
}
