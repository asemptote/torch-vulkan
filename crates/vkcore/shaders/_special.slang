  };

  
  static const FT P1[9] = {
      LIT(4.05544892305962419923E0),
      LIT(3.15251094599893866154E1),
      LIT(5.71628192246421288162E1),
      LIT(4.40805073893200834700E1),
      LIT(1.46849561928858024014E1),
      LIT(2.18663306850790267539E0),
      -LIT(1.40256079171354495875E-1),
      -LIT(3.50424626827848203418E-2),
      -LIT(8.57456785154685413611E-4),
  };

  static const FT Q1[9] = {
      LIT(1.00000000000000000000E0),
      LIT(1.57799883256466749731E1),
      LIT(4.53907635128879210584E1),
      LIT(4.13172038254672030440E1),
      LIT(1.50425385692907503408E1),
      LIT(2.50464946208309415979E0),
      -LIT(1.42182922854787788574E-1),
      -LIT(3.80806407691578277194E-2),
      -LIT(9.33259480895457427372E-4),
  };

  

  static const FT P2[9] = {
      LIT(3.23774891776946035970E0),
      LIT(6.91522889068984211695E0),
      LIT(3.93881025292474443415E0),
      LIT(1.33303460815807542389E0),
      LIT(2.01485389549179081538E-1),
      LIT(1.23716634817820021358E-2),
      LIT(3.01581553508235416007E-4),
      LIT(2.65806974686737550832E-6),
      LIT(6.23974539184983293730E-9),
  };

  static const FT Q2[9] = {
      LIT(1.00000000000000000000E0),
      LIT(6.02427039364742014255E0),
      LIT(3.67983563856160859403E0),
      LIT(1.37702099489081330271E0),
      LIT(2.16236993594496635890E-1),
      LIT(1.34204006088543189037E-2),
      LIT(3.28014464682127739104E-4),
      LIT(2.89247864745380683936E-6),
      LIT(6.79019408009981274425E-9),
  };

  if (y0 == zero) {
    return -m_inf();
  }
  if (y0 == one) {
    return m_inf();
  }
  if (y0 < zero || y0 > one) {
    return m_nan();
  }
  bool code = true;
  FT y = y0;
  if (y > one - FT(LIT(0.13533528323661269189))) { 
    y = one - y;
    code = false;
  }

  if (y > FT(LIT(0.13533528323661269189))) {
    y = y - FT(LIT(0.5));
    const FT y2 = y * y;
    FT x = y + y * (y2 * polevl(y2, P0, 4) / polevl(y2, Q0, 8));
    return (x * s2pi);
  }

  FT x = sqrt(FT(-LIT(2.0)) * m_log(y));
  const FT x0 = x - m_log(x) / x;

  const FT z = one / x;
  FT x1;
  if (x < FT(LIT(8.0))) 
  {
    x1 = z * polevl(z, P1, 8) / polevl(z, Q1, 8);
  } else {
    x1 = z * polevl(z, P2, 8) / polevl(z, Q2, 8);
  }
  x = x0 - x1;
  if (code) {
    x = -x;
  }
  return x;
}

