    if (x >= FT(LIT(2.09))) {
        domain_flag = 5;

        FT zeta = FT(LIT(2.0)) * x * sqrt(x) / FT(LIT(3.0));

        FT an = LIT(0.0);

        for (int index = 0; index <= 7; index++) {
