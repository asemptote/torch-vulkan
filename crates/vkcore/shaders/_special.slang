    };

    int domain_flag = 0;

    FT ai = FT(LIT(0.0));

    if (isinf(x)) {
        return m_nan();
    }

    if (x > FT(LIT(103.892))) {
        return FT(LIT(0.0));
    }

    FT f;
    FT g;
    FT k;

    if (x < FT(-LIT(2.09))) {
        FT z = FT(LIT(1.0)) / (FT(-LIT(2.0)) * x * sqrt(-x) / FT(LIT(3.0)));

        FT afn = LIT(0.0);

        for (int index = 0; index <= 8; index++) {
            afn = afn * (z * z) + AFN[index];
        }

        FT afd = LIT(0.0);

        for (int index = 0; index <= 8; index++) {
            afd = afd * (z * z) + AFD[index];
        }

        FT agn = LIT(0.0);

        for (int index = 0; index <= 10 + 0; index++) {
            agn = agn * (z * z) + AGN[index];
        }

        FT agd = LIT(0.0);

        for (int index = 0; index <= 10 - 1; index++) {
            agd = agd * (z * z) + AGD[index];
        }

        FT t = FT(-LIT(2.0)) * x * sqrt(-x) / FT(LIT(3.0)) + FT(LIT(0.25)) * K_PI;

        return FT(LIT(5.64189583547756286948e-01)) / sqrt(sqrt(-x)) * (m_sin(t) * (FT(LIT(1.0)) + z * z * afn / afd) - m_cos(t) * (z * agn / agd));
