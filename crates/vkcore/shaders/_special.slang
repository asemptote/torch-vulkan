    }                                           \
    return LIT(0.5) * (b0 - b2)

// num(x) / den(x) for coefficient arrays num[0..M], den[0..N] (SciPy ratevl).
#define RATEVL(x, num, M, den, N)                                                   \
    FT absx = abs(x), y = absx > FT(1) ? FT(1) / x : x;                             \
