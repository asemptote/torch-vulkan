    ck = d[k][0];
    for (n = 1; n < 25; n++) {
      if (n > maxpow) {
        etapow[n] = eta * etapow[n-1];
        maxpow += 1;
      }
      ckterm = d[k][n]*etapow[n];
      ck += ckterm;
      if (abs(ckterm) < MACHEP * abs(ck)) {
        break;
      }
    }
    term = ck * afac;
    absterm = abs(term);
    if (absterm > absoldterm) {
      break;
    }
    sum += term;
    if (absterm < MACHEP * abs(sum)) {
      break;
    }
    absoldterm = absterm;
    afac /= a;
  }
  res += sgn * m_exp(-LIT(0.5) * a * eta * eta) * sum / sqrt(2 * K_PI * a);

  return res;
}

static FT _igamc_helper_continued_fraction(FT a, FT x) {
  
  int i;
  FT ans, ax, c, yc, r, t, y, z;
  FT pk, pkm1, pkm2, qk, qkm1, qkm2;
  int MAXITER = 2000;
  const FT MACHEP = IS_F64 ?
    LIT(1.11022302462515654042E-16) : LIT(5.9604644775390625E-8);
  const FT BIG = IS_F64 ?
    LIT(4.503599627370496e15) : LIT(16777216.);
  const FT BIGINV = IS_F64 ?
    LIT(2.22044604925031308085e-16) : LIT(5.9604644775390625E-8);

  ax = _igam_helper_fac(a, x);
  if (ax == LIT(0.0)) {
    return LIT(0.0);
  }

  
  y = LIT(1.0) - a;
  z = x + y + LIT(1.0);
  c = LIT(0.0);
  pkm2 = LIT(1.0);
  qkm2 = x;
  pkm1 = x + LIT(1.0);
  qkm1 = z * x;
  ans = pkm1 / qkm1;

  for (i = 0; i < MAXITER; i++) {
    c += LIT(1.0);
    y += LIT(1.0);
    z += LIT(2.0);
    yc = y * c;
    pk = pkm1 * z - pkm2 * yc;
    qk = qkm1 * z - qkm2 * yc;
    if (qk != 0) {
      r = pk / qk;
      t = abs((ans - r) / r);
      ans = r;
    }
    else {
      t = LIT(1.0);
    }
    pkm2 = pkm1;
    pkm1 = pk;
    qkm2 = qkm1;
    qkm1 = qk;
    if (abs(pk) > BIG) {
      pkm2 *= BIGINV;
      pkm1 *= BIGINV;
      qkm2 *= BIGINV;
      qkm1 *= BIGINV;
    }
    if (t <= MACHEP) {
      break;
    }
  }
  return ans * ax;
}

FT calc_igammac(FT a, FT x) {
  
  FT absxma_a;

  const FT SMALL = LIT(20.0);
  const FT LARGE = LIT(200.0);
  const FT SMALLRATIO = LIT(0.3);
  const FT LARGERATIO = LIT(4.5);

  
  
  if ((x < 0) || (a < 0)) {
    
    return m_nan();
  }
  else if (a == 0) {
    if (x > 0) {
      return LIT(0.0);
    }
    else {
      return m_nan();
    }
  }
  else if (x == 0) {
    return LIT(1.0);
  }
  else if (isinf(a)) {
    if (isinf(x)) {
      return m_nan();
    }
    return LIT(1.0);
  }
  else if (isinf(x)) {
    return LIT(0.0);
  }

  absxma_a = abs(x - a) / a;
  if ((a > SMALL) && (a < LARGE) && (absxma_a < SMALLRATIO)) {
     return _igam_helper_asymptotic_series(a, x, 0);
  }
  else if ((a > LARGE) && (absxma_a < LARGERATIO / sqrt(a))) {
     return _igam_helper_asymptotic_series(a, x, 0);
  }

  if (x > LIT(1.1)) {
    if (x < a) {
      return LIT(1.0) - _igam_helper_series(a, x);
    }
    else {
      return _igamc_helper_continued_fraction(a, x);
    }
  }
  else if (x <= LIT(0.5)) {
    if (-LIT(0.4) / m_log(x) < a) {
      return LIT(1.0) - _igam_helper_series(a, x);
    }
    else {
      return _igamc_helper_series(a, x);
    }
  }
  else {
    if (x * LIT(1.1) < a) {
      return LIT(1.0) - _igam_helper_series(a, x);
    }
    else {
      return _igamc_helper_series(a, x);
    }
  }
}

FT calc_igamma(FT a, FT x) {
  
  FT absxma_a;
  const FT SMALL = LIT(20.0);
  const FT LARGE = LIT(200.0);
  const FT SMALLRATIO = LIT(0.3);
  const FT LARGERATIO = LIT(4.5);

  
  
  
  if ((x < 0) || (a < 0)) {
    
    return m_nan();
  }
  else if (a == 0) {
    if (x > 0) {
      return LIT(1.0);
    }
    else {
      return m_nan();
    }
  }
  else if (x == 0) {
    return LIT(0.0); 
  }
  else if (isinf(a)) {
    if (isinf(x)) {
      return m_nan();
    }
    return LIT(0.0);
  }
  else if (isinf(x)) {
    return LIT(1.0);
  }

  
  absxma_a = abs(x - a) / a;
  if ((a > SMALL) && (a < LARGE) && (absxma_a < SMALLRATIO)) {
    return _igam_helper_asymptotic_series(a, x, 1);
  }
  else if ((a > LARGE) && (absxma_a < LARGERATIO / sqrt(a))) {
    return _igam_helper_asymptotic_series(a, x, 1);
  }

  if ((x > LIT(1.0)) && (x > a)) {
    return LIT(1.0) - calc_igammac(a, x);
  }

  return _igam_helper_series(a, x);
}

