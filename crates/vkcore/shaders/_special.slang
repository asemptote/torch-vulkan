FT chebyshev_polynomial_t_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (abs(x) == FT(LIT(1.0))) {
        if (x > FT(LIT(0.0)) || n % 2 == 0) {
            return FT(LIT(1.0));
        }

        return FT(-LIT(1.0));
    }

    if ((n > 6) && (abs(x) < FT(LIT(1.0)))) {
        return m_cos(n * m_acos(x));
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x;
    }

    FT p = FT(LIT(1.0));
    FT q = x;
    FT r = x;

    for (int64_t k = 2; (k <= n) && !isnan(q); k++) {
        r = (x + x) * q - p;
        p = q;
        q = r;
    }

    return r;
}

FT chebyshev_polynomial_u_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (abs(x) == FT(LIT(1.0))) {
        if (x > FT(LIT(0.0)) || n % 2 == 0) {
            return n + 1;
        }

        return -(n + 1);
    }

    if ((n > 8) && (abs(x) < FT(LIT(1.0)))) {
        if (m_sin(m_acos(x)) != FT(LIT(0.0))) {
            return m_sin((n + 1) * m_acos(x)) / m_sin(m_acos(x));
        }

        return (n + 1) * m_cos((n + 1) * m_acos(x)) / x;
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x + x;
    }

    FT p = FT(LIT(1.0));
    FT q = x + x;
    FT r = q;

    for (int64_t k = 2; (k <= n) && !isnan(q); k++) {
        r = (x + x) * q - p;
        p = q;
        q = r;
    }

    return r;
}

FT chebyshev_polynomial_v_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (abs(x) == FT(LIT(1.0))) {
        if (x > FT(LIT(0.0))) {
            return FT(LIT(1.0));
        }

        if (n % 2 == 0) {
            return n + n + 1;
        }

        return -(n + n + 1);
    }

    if ((n > 8) && (abs(x) < FT(LIT(1.0)))) {
        if (m_sin(m_acos(x) / FT(LIT(2.0))) != FT(LIT(1.0))) {
            return m_cos((n + FT(LIT(0.5))) * m_acos(x)) / m_cos(m_acos(x) / FT(LIT(2.0)));
        }

        if (n % 2 == 0) {
            return n + n + 1;
        }

        return -(n + n + 1);
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x + x - FT(LIT(1.0));
    }

    FT p = FT(LIT(1.0));
    FT q = x + x - FT(LIT(1.0));
    FT r = q;

    for (int64_t k = 2; (k <= n) && !isnan(q); k++) {
        r = (x + x) * q - p;
        p = q;
        q = r;
    }

    return r;
}

FT chebyshev_polynomial_w_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (abs(x) == FT(LIT(1.0))) {
        if (x > FT(LIT(0.0))) {
            return n + n + 1;
        }

        if (n % 2 == 0) {
            return FT(LIT(1.0));
        }

        return FT(-LIT(1.0));
    }

    if ((n > 8) && (abs(x) < FT(LIT(1.0)))) {
        if (m_cos(m_acos(x) / FT(LIT(2.0))) != FT(LIT(1.0))) {
            return m_sin((n + FT(LIT(0.5))) * m_acos(x)) / m_sin(m_acos(x) / FT(LIT(2.0)));
        }

        if (x > FT(LIT(0.0))) {
            return n + n + 1;
        }

        if (n % 2 == 0) {
            return FT(LIT(1.0));
        }

        return FT(-LIT(1.0));
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x + x + FT(LIT(1.0));
    }

    FT p = FT(LIT(1.0));
    FT q = x + x + FT(LIT(1.0));
    FT r = q;

    for (int64_t k = 2; (k <= n) && !isnan(q); k++) {
        r = (x + x) * q - p;
        p = q;
        q = r;
    }

    return r;
}

FT hermite_polynomial_h_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x + x;
    }

    if (n > (IS_F64 ? 512 : 128)) {
        return m_nan();
    }

    FT p = FT(LIT(1.0));
    FT q = x + x;
    FT r = FT(LIT(0.0));

    for (int64_t k = 2; k < n + n; k += 2) {
        r = (x + x) * q - k * p;
        p = q;
        q = r;
    }

    return r;
}

FT hermite_polynomial_he_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x;
    }

    if (n > (IS_F64 ? 512 : 128)) {
        return m_nan();
    }

    FT p = FT(LIT(1.0));
    FT q = x;
    FT r;

    for (int64_t k = 1; k < n; k++) {
        r = x * q - k * p;
        p = q;
        q = r;
    }

    return r;
}

FT laguerre_polynomial_l_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (abs(x) == FT(LIT(0.0))) {
        return FT(LIT(1.0));
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return FT(LIT(1.0)) - x;
    }

    FT p = FT(LIT(1.0));
    FT q = FT(LIT(1.0)) - x;
    FT r = q;

    for (int64_t k = 1; (k < n) && !isnan(q); k++) {
        r = (((k + k) + (FT(LIT(1.0)) - x)) * q - k * p) / (k + 1);
        p = q;
        q = r;
    }

    return r;
}

FT legendre_polynomial_p_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (abs(x) == FT(LIT(1.0))) {
        if (x > FT(LIT(0.0)) || n % 2 == 0) {
            return FT(LIT(1.0));
        }

        return FT(-LIT(1.0));
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x;
    }

    FT p = FT(LIT(1.0));
    FT q = x;
    FT r = q;

    for (int64_t k = 1; (k < n) && !isnan(q); k++) {
        r = ((k + k + 1) * x * q - k * p) / (k + 1);
        p = q;
        q = r;
    }

    return r;
}

