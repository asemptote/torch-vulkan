        m /= k;
        f += m;
        k += FT(LIT(1.0));
        n /= k;
        g += n;

        t = abs(m / f);
    }

    if ((domain_flag & 1) == 0) {
        return FT(LIT(0.355028053887817239260)) * f - FT(LIT(0.258819403792806798405)) * g;
    }

    return ai;
}

