FT zeta(FT x, FT q)  {
  
  const FT MACHEP = FT(LIT(1.11022302462515654042E-16));
  const FT zero = FT(LIT(0.0));
  const FT half = FT(LIT(0.5));
  const FT one = FT(LIT(1.0));
  static const FT A[] = {
      LIT(12.0),
      -LIT(720.0),
      LIT(30240.0),
      -LIT(1209600.0),
      LIT(47900160.0),
      -LIT(1.8924375803183791606e9), 
      LIT(7.47242496e10),
      -LIT(2.950130727918164224e12), 
      LIT(1.1646782814350067249e14), 
      -LIT(4.5979787224074726105e15), 
      LIT(1.8152105401943546773e17), 
      -LIT(7.1661652561756670113e18) 
  };

  FT a, b, k, s, t, w;
  if (x == one) {
    return m_inf();
  }

  if (x < one) {
    return m_nan();
  }

  if (q <= zero) {
    if (q == floor(q)) {
      return m_inf();
    }
    if (x != floor(x)) {
      return m_nan();
    }
  }

  s = m_pow(q, -x);
  a = q;
  int i = 0;
  b = zero;
  while (((i < 9) || (a <= FT(LIT(9.0)))) && i < 1000000) {
    i += 1;
    a += one;
    b = m_pow(a, -x);
    s += b;
    if ((-MACHEP * s < b) && (b < MACHEP * s)) {
      return FT(s);
    }
  };

  w = a;
  s += b * w / (x - one);
  s -= half * b;
  a = one;
  k = zero;
  for (i = 0; i < 12; i++) {
    a *= x + k;
    b /= w;
    t = a * b / A[i];
    s = s + t;
    t = abs(t / s);
    if (t < MACHEP) {
      return FT(s);
    }
    k += one;
    a *= x + k;
    b /= w;
    k += one;
  }
  return FT(s);
}

FT trigamma(FT x)  {
  FT sign = +1;
  FT result = 0;
  if (x < LIT(0.5)) {
    sign = -1;
    const FT sin_pi_x = m_sin(K_PI * x);
    result -= (K_PI * K_PI) / (sin_pi_x * sin_pi_x);
    x = 1 - x;
  }
  for (int i = 0; i < 6; ++i) {
    result += 1 / (x * x);
    x += 1;
  }
  const FT ixx = 1 / (x*x);
  result += (1 + 1 / (2*x) + ixx * (LIT(1.)/6 - ixx * (LIT(1.)/30 - ixx * (LIT(1.)/42)))) / x;
  return sign * result;
}

FT calc_ndtri(FT y0) {

  
  const FT s2pi = LIT(2.50662827463100050242E0);
  const FT one = 1;
  const FT zero = 0;

  
