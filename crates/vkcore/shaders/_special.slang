FT erfcx_y100(FT y100)
{
    int k = int(y100);
    if (k < 0 || k >= 100)
        return LIT(1.0);
    FT t = 2 * y100 - FT(2 * k + 1);
    k = clamp(k, 0, 99);  // (calc_erfcx evaluates both of its arms: keep the row in range)
    FT r = ERFCX_Y100[k][6];
    for (int j = 0; j < 6; j++)
        r = ERFCX_Y100[k][5 - j] + r * t;
    return r;
}

FT calc_erfcx(FT x)
{
  if (isnan(x)) {
    return x;
  }

  if (x >= 0) {
    if (x > 50) { 
      const FT ispi = LIT(0.56418958354775628694807945156); 
      if (x > LIT(5e7)) { 
        return ispi / x;
      }
      
      return ispi*((x*x) * (x*x+LIT(4.5)) + 2) / (x * ((x*x) * (x*x+5) + LIT(3.75)));
    }
    return erfcx_y100(400/(4+x));
  }
  else {
    if (x < -LIT(26.7)) {
      return m_inf();
    }
    else if (x < -LIT(6.1)) {
      return 2*m_exp(x*x);
    }
    else {
      return 2*m_exp(x*x) - erfcx_y100(400/(4-x));
    }
  }
}

FT calc_log_ndtr(FT x) {
  FT t = x * K_SQRT1_2;
  if (x < FT(-LIT(1.0))) {
    return m_log(calc_erfcx(-t) / 2) - t * t;
  } else {
    return m_log1p(-m_erfc(t) / 2);
  }
}

static FT lanczos_sum_expg_scaled(FT x) {
  
  static const FT lanczos_sum_expg_scaled_num[13] = {
    LIT(0.006061842346248906525783753964555936883222),
    LIT(0.5098416655656676188125178644804694509993),
    LIT(19.51992788247617482847860966235652136208),
    LIT(449.9445569063168119446858607650988409623),
    LIT(6955.999602515376140356310115515198987526),
    LIT(75999.29304014542649875303443598909137092),
    LIT(601859.6171681098786670226533699352302507),
    LIT(3481712.15498064590882071018964774556468),
    LIT(14605578.08768506808414169982791359218571),
    LIT(43338889.32467613834773723740590533316085),
    LIT(86363131.28813859145546927288977868422342),
    LIT(103794043.1163445451906271053616070238554),
    LIT(56906521.91347156388090791033559122686859)
  };
  static const FT lanczos_sum_expg_scaled_denom[13] = {
    LIT(1.),
    LIT(66.),
    LIT(1925.),
    LIT(32670.),
    LIT(357423.),
    LIT(2637558.),
    LIT(13339535.),
    LIT(45995730.),
    LIT(105258076.),
    LIT(150917976.),
    LIT(120543840.),
    LIT(39916800.),
    LIT(0.)
  };
  RATEVL(x, lanczos_sum_expg_scaled_num, 12, lanczos_sum_expg_scaled_denom, 12);
}

static FT _igam_helper_fac(FT a, FT x) {
  
  
  

  FT ax, fac, res, num, numfac;
  const FT MAXLOG = IS_F64 ?
    LIT(7.09782712893383996843E2) : LIT(88.72283905206835);
  const FT EXP1 = LIT(2.718281828459045);
  const FT lanczos_g = LIT(6.024680040776729583740234375);

  if (abs(a - x) > LIT(0.4) * abs(a)) {
    ax = a * m_log(x) - x - m_lgamma(a);
    if (ax < -MAXLOG) {
      return LIT(0.0);
    }
    return m_exp(ax);
  }

  fac = a + lanczos_g - LIT(0.5);
  res = sqrt(fac / EXP1) / lanczos_sum_expg_scaled(a);

  if ((a < 200) && (x < 200)) {
    res *= m_exp(a - x) * m_pow(x / fac, a);
  }
  else {
    num = x - a - lanczos_g + LIT(0.5);
    numfac = num / fac;
    res *= m_exp(a * (m_log1p(numfac) - numfac) + x * (LIT(0.5) - lanczos_g) / fac);
  }
  return res;
}

static FT _igam_helper_series(FT a, FT x) {
  
  const FT MACHEP = IS_F64 ?
    LIT(1.11022302462515654042E-16) : LIT(5.9604644775390625E-8);
  const int MAXITER = 2000;

  int i;
  FT ans, ax, c, r;

  ax = _igam_helper_fac(a, x);
  if (ax == LIT(0.0)) {
    return LIT(0.0);
  }

  
  r = a;
  c = LIT(1.0);
  ans = LIT(1.0);

  for (i = 0; i < MAXITER; i++) {
    r += LIT(1.0);
    c *= x / r;
    ans += c;
    if (c <= MACHEP * ans) {
      break;
    }
  }
  return (ans * ax / a);
}

static FT _igamc_helper_series(FT a, FT x) {
  
  

  int n;
  FT fac = 1;
  FT sum = 0;
  FT term, logx;
  const FT MAXITER = 2000;
  const FT MACHEP = IS_F64 ?
    LIT(1.11022302462515654042E-16) : LIT(5.9604644775390625E-8);

  for (n = 1; n < MAXITER; n++) {
    fac *= -x / n;
    term = fac / (a + n);
    sum += term;
    if (abs(term) <= MACHEP * abs(sum)) {
        break;
    }
  }

  logx = m_log(x);
  term = -m_expm1(a * logx - m_lgamma(1+a));
  return term - m_exp(a * logx - m_lgamma(a)) * sum;
}

