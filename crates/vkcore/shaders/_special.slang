FT shifted_chebyshev_polynomial_t_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (x == FT(LIT(1.0))) {
        return FT(LIT(1.0));
    }

    if (x == FT(LIT(0.0))) {
        if (n % 2 == 0) {
            return FT(LIT(1.0));
        }

        return FT(-LIT(1.0));
    }

    if ((n > 6) && (abs(x + x - FT(LIT(1.0))) < FT(LIT(1.0)))) {
        return m_cos(n * m_acos(x + x - FT(LIT(1.0))));
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x + x - FT(LIT(1.0));
    }

    FT p = FT(LIT(1.0));
    FT q = x + x - FT(LIT(1.0));
    FT r = q;

    for (int64_t k = 2; (k <= n) && !isnan(q); k++) {
        r = (x + x - FT(LIT(1.0)) + (x + x - FT(LIT(1.0)))) * q - p;
        p = q;
        q = r;
    }

    return r;
}

FT shifted_chebyshev_polynomial_u_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (x == FT(LIT(1.0))) {
        return n + 1;
    }

    if (x == FT(LIT(0.0))) {
        if (n % 2 == 0) {
            return n + 1;
        }

        return -(n + 1);
    }

    if ((n > 6) && (abs(x + x - FT(LIT(1.0))) < FT(LIT(1.0)))) {
        if (m_sin(m_acos(x + x - FT(LIT(1.0)))) != FT(LIT(0.0))) {
            return m_sin((n + 1) * m_acos(x + x - FT(LIT(1.0)))) / m_sin(m_acos(x + x - FT(LIT(1.0))));
        }

        return (n + 1) * m_cos((n + 1) * m_acos(x + x - FT(LIT(1.0)))) / (x + x - FT(LIT(1.0)));
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x + x - FT(LIT(1.0)) + (x + x - FT(LIT(1.0)));
    }

    FT p = FT(LIT(1.0));
    FT q = x + x - FT(LIT(1.0)) + (x + x - FT(LIT(1.0)));
    FT r = q;

    for (int64_t k = 2; (k <= n) && !isnan(q); k++) {
        r = (x + x - FT(LIT(1.0)) + (x + x - FT(LIT(1.0)))) * q - p;
        p = q;
        q = r;
    }

    return r;
}

FT shifted_chebyshev_polynomial_v_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (x == FT(LIT(1.0))) {
        return FT(LIT(1.0));
    }

    if (x == FT(LIT(0.0))) {
        if (n % 2 == 0) {
            return (n + n + 1);
        }

        return -(n + n + 1);
    }

    if ((n > 6) && (abs(x + x - FT(LIT(1.0))) < FT(LIT(1.0)))) {
        if (m_sin(m_acos(x + x - FT(LIT(1.0))) / FT(LIT(2.0))) != FT(LIT(1.0))) {
            return m_cos((n + FT(LIT(0.5))) * m_acos(x + x - FT(LIT(1.0)))) / m_cos(m_acos(x + x - FT(LIT(1.0))) / FT(LIT(2.0)));
        }

        if (n % 2 == 0) {
            return n + n + 1;
        }

        return -(n + n + 1);
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x + x - FT(LIT(1.0)) + (x + x - FT(LIT(1.0))) - FT(LIT(1.0));
    }

    FT p = FT(LIT(1.0));
    FT q = x + x - FT(LIT(1.0)) + (x + x - FT(LIT(1.0))) - FT(LIT(1.0));
    FT r = q;

    for (int64_t k = 2; (k <= n) && !isnan(q); k++) {
        r = (x + x - FT(LIT(1.0)) + (x + x - FT(LIT(1.0)))) * q - p;
        p = q;
        q = r;
    }

    return r;
}

FT shifted_chebyshev_polynomial_w_forward(FT x, int64_t n) {
    if (n < 0) {
        return FT(LIT(0.0));
    }

    if (x == FT(LIT(1.0))) {
        return n + n + 1;
    }

    if (x == FT(LIT(0.0))) {
        if (n % 2 == 0) {
            return FT(LIT(1.0));
        }

        return FT(-LIT(1.0));
    }

    if ((n > 4) && (abs(x + x - FT(LIT(1.0))) < FT(LIT(1.0)))) {
        if (m_cos(m_acos(x + x - FT(LIT(1.0))) / FT(LIT(2.0))) != FT(LIT(1.0))) {
            return m_sin((n + FT(LIT(0.5))) * m_acos(x + x - FT(LIT(1.0)))) / m_sin(m_acos(x + x - FT(LIT(1.0))) / FT(LIT(2.0)));
        }

        if (n % 2 == 0) {
            return FT(LIT(1.0));
        }

        return FT(-LIT(1.0));
    }

    if (n == 0) {
        return FT(LIT(1.0));
    }

    if (n == 1) {
        return x + x - FT(LIT(1.0)) + (x + x - FT(LIT(1.0))) + FT(LIT(1.0));
    }

    FT p = FT(LIT(1.0));
    FT q = x + x - FT(LIT(1.0)) + (x + x - FT(LIT(1.0))) + FT(LIT(1.0));
    FT r = q;

    for (int64_t k = 2; (k <= n) && !isnan(q); k++) {
        r = (x + x - FT(LIT(1.0)) + (x + x - FT(LIT(1.0)))) * q - p;
        p = q;
        q = r;
    }

    return r;
}

FT spherical_bessel_j0_forward(FT x) {
    if (isinf(x)) {
        return FT(LIT(0.0));
    }

    if (abs(x) < FT(LIT(0.5))) {
        return FT(LIT(1.0)) + x * x * (FT(-LIT(1.0)) / FT(LIT(6.0)) + x * x * (FT(LIT(1.0)) / FT(LIT(120.0)) + x * x * (FT(-LIT(1.0)) / FT(LIT(5040.0)) + x * x * (FT(LIT(1.0)) / FT(LIT(362880.0)) + x * x * (FT(-LIT(1.0)) / FT(LIT(39916800.0)) + x * x * (FT(LIT(1.0)) / FT(LIT(6227020800.0))))))));
    }

    return m_sin(x) / x;
}
