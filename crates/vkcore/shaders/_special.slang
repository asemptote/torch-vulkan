        }
    }

    f = LIT(1.0);
    g = x;
    k = LIT(1.0);

    FT m = LIT(1.0);
    FT n = x;
    FT t = LIT(1.0);
    FT z = x * x * x;

    for (int guard = 0; t > M_EPS && guard < 100000; guard++) {
        m *= z;
