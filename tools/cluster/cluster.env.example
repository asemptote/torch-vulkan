# Site settings for the cluster scripts (queue-run.sh, dev.sh, full-run.sh,
# sync.sh). Copy to tools/cluster/cluster.env (git-ignored) and fill in:
#   cp tools/cluster/cluster.env.example tools/cluster/cluster.env
# The scripts source it as bash; the VAR=${VAR:-value} form lets a value
# already in the environment win. sync.sh and dev.sh copy it along with the
# tree, so the copies on the cluster see it too.

# ssh options for every connection, e.g. a jump host
CLUSTER_SSH=${CLUSTER_SSH:--J gateway.example.edu}
# remote user name (empty: ssh's default, or your ~/.ssh/config)
CLUSTER_USER=${CLUSTER_USER:-}

# Run directories, on a file system every machine below shares
RUNS=${RUNS:-/shared/scratch/me/torch-vulkan-runs}

# The PBS head node (qsub); empty: no cluster jobs, workstations only
PBS_HEAD=${PBS_HEAD:-headnode}
# PBS queue for the single-core lavapipe jobs (empty: the site's default)
LAVAPIPE_QUEUE=${LAVAPIPE_QUEUE:-}
# GPU queues, one GPU job each per run (empty: none); the first one is also
# where dev.sh DRIVER=nvidia and full-run.sh --gpu submit
GPU_QUEUES=${GPU_QUEUES:-gpu}

# Workstations that backfill runs with one lavapipe worker per core
# (pool.sh); per-host worker counts as <HOST>_WORKERS, e.g. WS1_WORKERS=8
BACKFILL_HOSTS=${BACKFILL_HOSTS:-ws1 ws2}
# One of them whose own NVIDIA GPU can join the NVIDIA run with
# BACKFILL_GPU_WORKERS (default 0) workers
GPU_HOST=${GPU_HOST:-}
# Where queue-run.sh creates the queues and reads their status
# (default: the first backfill host)
QUEUE_HOST=${QUEUE_HOST:-}

# dev.sh: the host for lavapipe runs and the dev copy's directory (on the
# shared file system, so GPU jobs see it)
DEV_HOST=${DEV_HOST:-ws1}
DEV_DIR=${DEV_DIR:-/shared/scratch/me/tv-dev}
